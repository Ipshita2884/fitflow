// ============================================================
// FitFlow — Prisma Schema
// PostgreSQL, UUID primary keys, full audit timestamps
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------- ENUMS -------------------------

enum Role {
  TRAINER
  CLIENT
  ADMIN
}

enum CertificationStatus {
  UPLOADED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum FitnessLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum GoalType {
  WEIGHT_LOSS
  WEIGHT_GAIN
  ENDURANCE
  STRENGTH
  FLEXIBILITY
  CONSISTENCY
  OTHER
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum SessionCategory {
  ZUMBA_BEGINNER
  ZUMBA_FAT_BURN
  ZUMBA_TONING
  DANCE_CARDIO
  HIIT_ZUMBA
  LOW_IMPACT_ZUMBA
  STRENGTH_ZUMBA
  MOBILITY_ZUMBA
  CUSTOM
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum SessionMode {
  IN_PERSON
  ONLINE
}

enum SessionStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum ExercisePhase {
  WARM_UP
  MAIN
  STRENGTH_CARDIO
  COOLDOWN
}

enum BookingStatus {
  BOOKED
  WAITLISTED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  CANCELLED
}

enum PlanFrequency {
  WEEKLY
  MONTHLY
  CUSTOM
}

enum NotificationType {
  BOOKING
  MILESTONE
  ATTENDANCE_ALERT
  SESSION_REMINDER
  PLAN_UPDATED
  MESSAGE
  REVIEW
  SYSTEM
}

enum QueryStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

// ------------------------- CORE AUTH -------------------------

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  role              Role
  isEmailVerified   Boolean   @default(false)
  emailVerifyToken  String?
  passwordResetToken String?
  passwordResetExpiresAt DateTime?
  refreshTokenHash  String?
  lastSeenAt        DateTime?
  isOnline          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  trainerProfile    TrainerProfile?
  clientProfile     ClientProfile?
  notifications     Notification[]
  conversations     ConversationParticipant[]
  sentMessages      Message[]                 @relation("SentMessages")
  readReceipts      MessageReadReceipt[]

  @@index([role])
}

// ------------------------- TRAINER SIDE -------------------------

model TrainerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug             String   @unique
  fullName         String
  bio              String?
  profilePictureUrl String?
  yearsExperience  Int?
  specializations  String[]
  zumbaCategories  SessionCategory[]
  rating           Decimal? @db.Decimal(2, 1)
  reviewCount      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  certifications   Certification[]
  achievements     Achievement[]
  galleryImages    GalleryImage[]
  availabilities   TrainerAvailability[]
  sessions         Session[]
  clients          ClientProfile[]
  reviews          Review[]
  memberships      Membership[]
  privateNotes     TrainerPrivateNote[]
}

model Certification {
  id                 String              @id @default(uuid())
  trainerId          String
  trainer            TrainerProfile      @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  name               String
  issuingOrganization String
  certificateId      String?
  issueDate          DateTime
  expiryDate         DateTime?
  fileUrl            String
  status             CertificationStatus @default(UPLOADED)
  verifiedByAdminId  String?
  verifiedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([trainerId, status])
}

model Achievement {
  id          String         @id @default(uuid())
  trainerId   String
  trainer     TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  year        Int?
  createdAt   DateTime       @default(now())

  @@index([trainerId])
}

model GalleryImage {
  id        String         @id @default(uuid())
  trainerId String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  createdAt DateTime       @default(now())

  @@index([trainerId])
}

model TrainerAvailability {
  id           String         @id @default(uuid())
  trainerId    String
  trainer      TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  dayOfWeek    Int            // 0-6
  startTime    String         // "09:00"
  endTime      String         // "18:00"
  isRecurring  Boolean        @default(true)
  createdAt    DateTime       @default(now())

  @@index([trainerId, dayOfWeek])
}

// ------------------------- CLIENT SIDE -------------------------

model ClientProfile {
  id             String         @id @default(uuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainerId      String?
  trainer        TrainerProfile? @relation(fields: [trainerId], references: [id])
  fullName       String
  age            Int?
  phone          String?
  profilePictureUrl String?
  joiningDate    DateTime       @default(now())
  heightCm       Decimal?       @db.Decimal(5, 2)
  currentWeightKg Decimal?      @db.Decimal(5, 2)
  targetWeightKg  Decimal?      @db.Decimal(5, 2)
  startingWeightKg Decimal?     @db.Decimal(5, 2)
  bloodType      String?
  primaryGoal    String?
  medicalConditions String?
  fitnessLevel   FitnessLevel?
  status         String         @default("ACTIVE") // ACTIVE | PAUSED | INACTIVE
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  measurements      BodyMeasurement[]
  assessments       FitnessAssessment[]
  goals             FitnessGoal[]
  workoutPlans      WorkoutPlan[]
  bookings          SessionBooking[]
  attendanceRecords Attendance[]
  calorieLogs       CalorieLog[]
  progressLogs      ProgressLog[]
  reports           Report[]
  reviews           Review[]
  memberships       Membership[]
  privateNotes      TrainerPrivateNote[]
  progressPhotos    ProgressPhoto[]
  achievements      ClientAchievement[]

  @@index([trainerId, status])
  @@index([trainerId, fitnessLevel])
}

model BodyMeasurement {
  id            String        @id @default(uuid())
  clientId      String
  client        ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recordedAt    DateTime      @default(now())
  weightKg      Decimal?      @db.Decimal(5, 2)
  waistCm       Decimal?      @db.Decimal(5, 2)
  chestCm       Decimal?      @db.Decimal(5, 2)
  hipCm         Decimal?      @db.Decimal(5, 2)
  armsCm        Decimal?      @db.Decimal(5, 2)
  thighsCm      Decimal?      @db.Decimal(5, 2)
  bodyFatPercent Decimal?     @db.Decimal(4, 2)
  createdAt     DateTime      @default(now())

  @@index([clientId, recordedAt])
}

model FitnessAssessment {
  id           String        @id @default(uuid())
  clientId     String
  client       ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assessedAt   DateTime      @default(now())
  endurance    Int?          // 1-10 scale
  strength     Int?
  flexibility  Int?
  mobility     Int?
  notes        String?
  isBaseline   Boolean       @default(false)
  createdAt    DateTime      @default(now())

  @@index([clientId, assessedAt])
}

// ------------------------- GOALS -------------------------

model FitnessGoal {
  id          String         @id @default(uuid())
  clientId    String
  client      ClientProfile  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        GoalType
  title       String
  startValue  Decimal?       @db.Decimal(6, 2)
  targetValue Decimal?       @db.Decimal(6, 2)
  unit        String?        // "kg", "sessions/week", etc.
  status      GoalStatus     @default(ACTIVE)
  startedAt   DateTime       @default(now())
  targetDate  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  milestones  GoalMilestone[]

  @@index([clientId, status])
}

model GoalMilestone {
  id           String      @id @default(uuid())
  goalId       String
  goal         FitnessGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  targetValue  Decimal     @db.Decimal(6, 2)
  order        Int
  isCompleted  Boolean     @default(false)
  completedAt  DateTime?
  createdAt    DateTime    @default(now())

  @@index([goalId, order])
}

// ------------------------- WORKOUTS / PLANS -------------------------

model WorkoutPlan {
  id          String        @id @default(uuid())
  clientId    String
  client      ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  frequency   PlanFrequency
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workouts    Workout[]

  @@index([clientId, startDate])
}

model Workout {
  id           String      @id @default(uuid())
  planId       String
  plan         WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayOfWeek    Int         // 0-6, or use scheduledDate for custom plans
  scheduledDate DateTime?
  title        String      // e.g. "Fat Burn Zumba"
  durationMin  Int?
  isRestDay    Boolean     @default(false)
  linkedSessionId String?
  linkedSession Session?  @relation(fields: [linkedSessionId], references: [id])
  createdAt    DateTime    @default(now())

  @@index([planId, dayOfWeek])
}

model Exercise {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String?
  createdAt   DateTime @default(now())

  sessionExercises SessionExercise[]
}

// ------------------------- SESSIONS -------------------------

model Session {
  id               String          @id @default(uuid())
  trainerId        String
  trainer          TrainerProfile  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  category         SessionCategory
  difficulty       Difficulty
  durationMin      Int
  maxParticipants  Int
  scheduledDate    DateTime
  mode             SessionMode
  location         String?
  imageUrl         String?
  estimatedCalories Int?
  status           SessionStatus   @default(SCHEDULED)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  exercises        SessionExercise[]
  bookings         SessionBooking[]
  attendance       Attendance[]
  workouts         Workout[]

  @@index([trainerId, scheduledDate])
  @@index([status])
}

model SessionExercise {
  id         String        @id @default(uuid())
  sessionId  String
  session    Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String?
  exercise   Exercise?     @relation(fields: [exerciseId], references: [id])
  phase      ExercisePhase
  name       String
  durationSec Int?
  order      Int
  notes      String?

  @@index([sessionId, phase, order])
}

model SessionBooking {
  id          String        @id @default(uuid())
  sessionId   String
  session     Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clientId    String
  client      ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status      BookingStatus @default(BOOKED)
  bookedAt    DateTime      @default(now())
  cancelledAt DateTime?

  @@unique([sessionId, clientId])
  @@index([sessionId, status])
  @@index([clientId, status])
}

model Attendance {
  id         String           @id @default(uuid())
  sessionId  String
  session    Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clientId   String
  client     ClientProfile    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status     AttendanceStatus
  markedAt   DateTime         @default(now())

  @@unique([sessionId, clientId])
  @@index([clientId, markedAt])
}

// ------------------------- PROGRESS / CALORIES -------------------------

model CalorieLog {
  id               String        @id @default(uuid())
  clientId         String
  client           ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date             DateTime      @db.Date
  caloriesConsumed Int?
  caloriesBurned   Int?
  targetCalories   Int?          // snapshot of estimate for that day
  createdAt        DateTime      @default(now())

  @@unique([clientId, date])
  @@index([clientId, date])
}

model ProgressLog {
  id             String        @id @default(uuid())
  clientId       String
  client         ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  weightKg       Decimal?      @db.Decimal(5, 2)
  waterMl        Int?
  steps          Int?
  sleepHours     Decimal?      @db.Decimal(3, 1)
  mood           String?
  workoutIntensity Int?        // 1-10
  createdAt      DateTime      @default(now())

  @@unique([clientId, date])
  @@index([clientId, date])
}

// ------------------------- COMMUNICATION -------------------------

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
}

model Conversation {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  text           String
  queryStatus    QueryStatus?
  priority       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  readReceipts   MessageReadReceipt[]

  @@index([conversationId, createdAt])
}

model MessageReadReceipt {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
}

// ------------------------- REVIEWS -------------------------

model Review {
  id          String         @id @default(uuid())
  trainerId   String
  trainer     TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  clientId    String
  client      ClientProfile  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  rating      Int            // 1-5
  reviewText  String?
  isApproved  Boolean        @default(false)
  isFeatured  Boolean        @default(false)
  createdAt   DateTime       @default(now())

  @@unique([trainerId, clientId])
  @@index([trainerId, isApproved])
}

// ------------------------- 360 CLIENT PROFILE MODELS -------------------------

model TrainerPrivateNote {
  id        String         @id @default(uuid())
  trainerId String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  clientId  String
  client    ClientProfile  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  content   String
  category  String         // "GENERAL", "SESSION", "FOLLOW_UP"
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([trainerId, clientId])
}

model ProgressPhoto {
  id        String        @id @default(uuid())
  clientId  String
  client    ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  imageUrl  String
  view      String        // "FRONT", "SIDE", "BACK"
  date      DateTime      @default(now())

  @@index([clientId, date])
}

model ClientAchievement {
  id          String        @id @default(uuid())
  clientId    String
  client      ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  description String
  iconName    String
  unlockedAt  DateTime      @default(now())

  @@index([clientId])
}

// ------------------------- REPORTS -------------------------

model Report {
  id           String        @id @default(uuid())
  clientId     String
  client       ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  periodEnd    DateTime
  pdfUrl       String?
  trainerRemarks String?
  generatedAt  DateTime      @default(now())

  @@index([clientId, generatedAt])
}

// ------------------------- BUSINESS (future-ready) -------------------------

model Membership {
  id          String           @id @default(uuid())
  clientId    String
  client      ClientProfile    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trainerId   String
  trainer     TrainerProfile   @relation(fields: [trainerId], references: [id])
  planName    String
  status      MembershipStatus @default(TRIAL)
  startDate   DateTime
  expiryDate  DateTime?
  createdAt   DateTime         @default(now())

  payments    Payment[]

  @@index([clientId, status])
}

model Payment {
  id           String     @id @default(uuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  amount       Decimal    @db.Decimal(10, 2)
  currency     String     @default("USD")
  status       String     // PENDING | PAID | FAILED | REFUNDED
  paidAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([membershipId, status])
}
